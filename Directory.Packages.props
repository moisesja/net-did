<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Cryptography (NSec.Cryptography, NBitcoin.Secp256k1, Nethermind.Crypto.Bls
         are no longer pinned here: NetCrypto owns them and brings them transitively.
         Re-add a pin only if a project takes a direct PackageReference. -->
    <PackageVersion Include="NetCrypto" Version="1.7.1" />
    <!-- Data Integrity proofs (did:webvh) -->
    <PackageVersion Include="DataProofsDotnet.Core" Version="1.4.0" />
    <!-- Encoding -->
    <PackageVersion Include="NetCid" Version="1.6.0" />
    <PackageVersion Include="Testcontainers" Version="4.16.0" />
    <!-- Caching -->
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.14" />
    <!-- Logging -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <!-- Dependency Injection -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.14" />
    <!-- Identity / JWK -->
    <PackageVersion Include="Microsoft.IdentityModel.Tokens" Version="8.23.0" />
    <!-- Source Link -->
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.403" />
    <!-- Testing -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <!-- xUnit v3 with Microsoft Testing Platform off, so tests keep running under VSTest on the
         .NET 10 SDK: `dotnet test`, its filter syntax, and coverlet.collector are unchanged. -->
    <PackageVersion Include="xunit.v3.mtp-off" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
  </ItemGroup>
</Project>
