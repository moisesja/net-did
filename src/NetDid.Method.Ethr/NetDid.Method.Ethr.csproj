  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../NetDid.Core/NetDid.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
