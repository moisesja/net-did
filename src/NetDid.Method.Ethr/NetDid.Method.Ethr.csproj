    <Description>did:ethr method implementation for the NetDid multi-method DID library.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NetDid.Method.Ethr.Tests" />
  </ItemGroup>

  <ItemGroup>
